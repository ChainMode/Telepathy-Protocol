# === Default: ignore everything at root (keep process/governance files local) ===
/*

# === Public deliverables (docs, schemas, vectors, reference SDK, and verification tests) ===
!/docs/
!/ref/
!/schema/
!/schemas/
!/vectors/
!/src/
!/tests/
!/package.json
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/.gitignore
!/.editorconfig
!/.prettierrc
!/.github/

# === Exclude build/cache/OS/env noise inside allowed directories ===
.DS_Store
*.swp
*.swo
*~
Thumbs.db
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.env
.env.*
